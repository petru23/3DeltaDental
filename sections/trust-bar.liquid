{% comment %}
  Trust Bar Section - Display key trust signals for 3 Delta Dental
  Shows trust points like TGA Approved, European Brands, Years of Experience, Support
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign icon_color = section.settings.icon_color
-%}

<div
  class="trust-bar"
  style="background-color: {{ bg_color }}; color: {{ text_color }};"
>
  <div class="trust-bar__container">
    {% if section.settings.heading != blank %}
      <p class="trust-bar__overheading" style="color: {{ icon_color }};">
        {{ section.settings.heading }}
      </p>
    {% endif %}

    <div class="trust-bar__items">
      {% for block in section.blocks %}
        <div class="trust-bar__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="trust-bar__icon" style="color: {{ icon_color }};">
              {% case block.settings.icon %}
                {% when 'checkmark' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
                {% when 'globe' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                {% when 'star' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {% when 'phone' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                {% when 'award' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="8" r="7"/>
                    <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                  </svg>
                {% when 'truck' %}
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"/>
                    <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                    <circle cx="5.5" cy="18.5" r="2.5"/>
                    <circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                {% else %}
                  {{ block.settings.icon }}
              {% endcase %}
            </div>
          {% endif %}
          {% if block.settings.title != blank %}
            <p class="trust-bar__title">{{ block.settings.title }}</p>
          {% endif %}
          {% if block.settings.description != blank %}
            <p class="trust-bar__description">{{ block.settings.description }}</p>
          {% endif %}
        </div>

        {% unless forloop.last %}
          <div class="trust-bar__divider" style="border-color: {{ text_color }};"></div>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .trust-bar {
    padding: {{ section.settings.padding_vertical }}px 2rem;
    width: 100%;
  }

  .trust-bar__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .trust-bar__overheading {
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .trust-bar__items {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
  }

  .trust-bar__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.5rem 2rem;
    flex: 1;
    min-width: 150px;
  }

  .trust-bar__icon {
    font-size: 1.75rem;
    margin-bottom: 0.4rem;
    line-height: 1;
  }

  .trust-bar__title {
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0 0 0.15rem 0;
    line-height: 1.3;
  }

  .trust-bar__description {
    font-size: 0.75rem;
    opacity: 0.75;
    margin: 0;
    line-height: 1.4;
  }

  .trust-bar__divider {
    width: 0;
    height: 40px;
    border-left: 1px solid;
    opacity: 0.2;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .trust-bar {
      padding: 1.25rem 1rem;
    }

    .trust-bar__items {
      gap: 1rem;
    }

    .trust-bar__item {
      padding: 0.5rem 1rem;
      min-width: 130px;
    }

    .trust-bar__divider {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Overheading",
      "info": "Optional small text above the trust items. Leave blank to hide."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#003B56"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon & Accent Color",
      "default": "#FED440"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical Padding (px)",
      "min": 8,
      "max": 80,
      "step": 4,
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "checkmark",
              "label": "Checkmark"
            },
            {
              "value": "globe",
              "label": "Globe"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "truck",
              "label": "Truck"
            }
          ],
          "default": "checkmark"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "TGA Approved"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "All products meet TGA standards"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "checkmark",
            "title": "TGA Approved",
            "description": "All products meet Australian standards"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "globe",
            "title": "European Brands",
            "description": "Premium manufacturers from Europe"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "award",
            "title": "37+ Years Expertise",
            "description": "Trusted since 1987"
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "phone",
            "title": "24/7 Support",
            "description": "Expert help when you need it"
          }
        }
      ]
    }
  ]
}
{% endschema %}
