{% comment %}
  Brand Showcase Section - Display brand logos for 3 Delta Dental
  Highlights European manufacturer partnerships and official distributor status
{% endcomment %}

{%- liquid
  assign bg_color = section.settings.background_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign logo_bg = section.settings.logo_background_color
  assign logo_border = section.settings.logo_border_color
-%}

<div
  class="brand-showcase"
  style="background-color: {{ bg_color }}; color: {{ text_color }};"
>
  <div class="brand-showcase__container">
    <div class="brand-showcase__header">
      {% if section.settings.badge_text != blank %}
        <p class="brand-showcase__badge" style="color: {{ accent_color }}; border-color: {{ accent_color }};">
          {{ section.settings.badge_text }}
        </p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h2 class="brand-showcase__title">{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="brand-showcase__subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="brand-showcase__grid" style="--logo-columns: {{ section.settings.columns }}; --logo-columns-mobile: {{ section.settings.columns_mobile }};">
        {% for block in section.blocks %}
          <div class="brand-showcase__brand-wrapper" {{ block.shopify_attributes }}>
            {% if block.settings.link != blank %}
              <a
                href="{{ block.settings.link }}"
                class="brand-showcase__brand"
                aria-label="{{ block.settings.brand_name | default: 'Brand' }}"
                style="background-color: {{ logo_bg }}; border-color: {{ logo_border }};"
                {% if block.settings.open_in_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
              >
            {% else %}
              <div
                class="brand-showcase__brand"
                style="background-color: {{ logo_bg }}; border-color: {{ logo_border }};"
              >
            {% endif %}

              {% if block.settings.logo != blank %}
                <img
                  src="{{ block.settings.logo | image_url: width: 300 }}"
                  alt="{{ block.settings.brand_name | default: block.settings.logo.alt | default: 'Brand logo' }}"
                  width="{{ block.settings.logo.width | at_most: 300 }}"
                  height="{{ block.settings.logo.height | at_most: 120 }}"
                  loading="lazy"
                  class="brand-showcase__logo-img"
                >
              {% elsif block.settings.brand_name != blank %}
                <p class="brand-showcase__brand-name" style="color: {{ text_color }};">
                  {{ block.settings.brand_name }}
                </p>
              {% endif %}

            {% if block.settings.link != blank %}
              </a>
            {% else %}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
      <div class="brand-showcase__cta">
        <a
          href="{{ section.settings.cta_link }}"
          class="brand-showcase__cta-button"
          style="background-color: {{ accent_color }}; color: {{ section.settings.cta_text_color }};"
        >
          {{ section.settings.cta_label }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
  .brand-showcase {
    padding: {{ section.settings.padding_top }}px 2rem {{ section.settings.padding_bottom }}px;
    width: 100%;
  }

  .brand-showcase__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .brand-showcase__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .brand-showcase__badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border: 1px solid;
    border-radius: 50px;
    padding: 0.3rem 1rem;
    margin-bottom: 0.75rem;
  }

  .brand-showcase__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    line-height: 1.2;
  }

  .brand-showcase__subtitle {
    font-size: 1rem;
    opacity: 0.75;
    margin: 0;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .brand-showcase__grid {
    display: grid;
    grid-template-columns: repeat(var(--logo-columns, 5), 1fr);
    gap: {{ section.settings.gap }}px;
    align-items: center;
  }

  .brand-showcase__brand-wrapper {
    display: flex;
    align-items: stretch;
  }

  .brand-showcase__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 1.25rem 1rem;
    border: 1px solid;
    border-radius: 8px;
    transition: all 0.25s ease;
    text-decoration: none;
    min-height: 90px;
  }

  a.brand-showcase__brand:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
  }

  .brand-showcase__logo-img {
    max-width: 100%;
    max-height: 70px;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
  }

  .brand-showcase__brand-name {
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    margin: 0;
    letter-spacing: 0.05em;
  }

  .brand-showcase__cta {
    text-align: center;
    margin-top: 2.5rem;
  }

  .brand-showcase__cta-button {
    display: inline-block;
    padding: 0.875rem 2.5rem;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .brand-showcase__cta-button:hover {
    opacity: 0.88;
  }

  @media (max-width: 900px) {
    .brand-showcase__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .brand-showcase {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .brand-showcase__grid {
      grid-template-columns: repeat(var(--logo-columns-mobile, 2), 1fr);
    }

    .brand-showcase__title {
      font-size: 1.5rem;
    }
  }
</style>

{% schema %}
{
  "name": "Brand Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section Content"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "info": "Small badge above the title (e.g. 'Official Distributor'). Leave blank to hide.",
      "default": "Official Distributor"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Trusted Brands"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We are the authorised Australian distributor for leading European dental manufacturers"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "info": "Leave blank to hide the button.",
      "default": "View All Brands"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Brand Columns (Desktop)",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Brand Columns (Mobile)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Logos (px)",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top (px)",
      "min": 16,
      "max": 120,
      "step": 8,
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom (px)",
      "min": 16,
      "max": 120,
      "step": 8,
      "default": 64
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#003B56"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent / Badge Color",
      "default": "#03B239"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "CTA Button Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "logo_background_color",
      "label": "Logo Card Background",
      "default": "#F8F8F8"
    },
    {
      "type": "color",
      "id": "logo_border_color",
      "label": "Logo Card Border",
      "default": "#E5E5E5"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Brand Logo",
          "info": "Recommended: PNG with transparent background, at least 300px wide"
        },
        {
          "type": "text",
          "id": "brand_name",
          "label": "Brand Name",
          "info": "Shown as text if no logo is uploaded, also used as alt text",
          "default": "Brand Name"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)",
          "info": "Link to a brand collection page or external URL. Leave blank for no link."
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Showcase",
      "blocks": [
        {
          "type": "brand",
          "settings": {
            "brand_name": "Brand 1"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "Brand 2"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "Brand 3"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "Brand 4"
          }
        },
        {
          "type": "brand",
          "settings": {
            "brand_name": "Brand 5"
          }
        }
      ]
    }
  ]
}
{% endschema %}
