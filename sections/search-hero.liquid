{% comment %}
  Search Hero Section - Prominent search bar for 3 Delta Dental
  Simple, clean design focused on helping customers find products quickly
{% endcomment %}

<style>
  .search-hero {
    background: var(--color-background);
    padding: 4rem 2rem;
    text-align: center;
  }

  .search-hero__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .search-hero__heading {
    font-size: 2.5rem;
    color: var(--color-foreground-heading);
    margin-bottom: 1rem;
    font-weight: 700;
  }

  .search-hero__subheading {
    font-size: 1.125rem;
    color: var(--color-foreground);
    margin-bottom: 2rem;
  }

  .search-hero__search-form {
    max-width: 700px;
    margin: 0 auto;
    position: relative;
  }

  .search-hero__input {
    width: 100%;
    padding: 1.25rem 4rem 1.25rem 1.5rem;
    font-size: 1.125rem;
    border: 2px solid var(--color-border);
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .search-hero__input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(3, 178, 57, 0.1);
  }

  .search-hero__button {
    position: absolute;
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .search-hero__button:hover {
    background: var(--color-primary-button-hover-background);
  }

  .search-hero__suggestions {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-foreground);
  }

  .search-hero__suggestions strong {
    font-weight: 600;
    color: var(--color-foreground-heading);
  }

  @media (max-width: 768px) {
    .search-hero {
      padding: 2rem 1rem;
    }

    .search-hero__heading {
      font-size: 1.75rem;
    }

    .search-hero__subheading {
      font-size: 1rem;
    }

    .search-hero__input {
      padding: 1rem 1rem;
      font-size: 1rem;
    }

    .search-hero__button {
      position: static;
      transform: none;
      width: 100%;
      margin-top: 0.75rem;
    }
  }
</style>

<div class="search-hero color-{{ section.settings.color_scheme }}">
  <div class="search-hero__container">
    {% if section.settings.heading != blank %}
      <h1 class="search-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="search-hero__subheading">
        {{ section.settings.subheading }}
      </p>
    {% endif %}

    <form action="{{ routes.search_url }}" method="get" class="search-hero__search-form" role="search">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ section.settings.search_placeholder }}"
        class="search-hero__input"
        aria-label="Search"
      />
      <button type="submit" class="search-hero__button">
        {{ section.settings.button_text }}
      </button>
    </form>

    {% if section.settings.show_suggestions %}
      <div class="search-hero__suggestions">
        <strong>Popular searches:</strong>
        {{ section.settings.popular_searches }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Search Hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Dental Lab Supplies"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Search by product name, SKU, or category"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search Placeholder",
      "default": "Search products..."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_suggestions",
      "label": "Show Popular Searches",
      "default": true
    },
    {
      "type": "text",
      "id": "popular_searches",
      "label": "Popular Searches",
      "default": "Acrylics, Burs, CAD/CAM Products, Polishing"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color Scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Search Hero"
    }
  ]
}
{% endschema %}
