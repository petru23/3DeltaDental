{% comment %}
  About Page Section - Fully Editable
{% endcomment %}

{%- style -%}
  .about-hero {
    background: linear-gradient(135deg, {{ section.settings.hero_bg_start }} 0%, {{ section.settings.hero_bg_end }} 100%);
    color: {{ section.settings.hero_text_color }};
    padding: 4rem 2rem;
    text-align: center;
  }
  .about-hero__container {
    max-width: 800px;
    margin: 0 auto;
  }
  .about-hero__title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: {{ section.settings.hero_text_color }};
  }
  .about-hero__subtitle {
    font-size: 1.25rem;
    opacity: 0.95;
  }
  .about-content {
    max-width: 1000px;
    margin: 0 auto;
    padding: 4rem 2rem;
  }
  .about-section-title {
    color: {{ section.settings.section_title_color }};
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .about-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #0D0D0D;
    margin-bottom: 1rem;
  }
  .about-features {
    background: #F7F7F7;
    padding: 4rem 2rem;
  }
  .about-features__container {
    max-width: 1200px;
    margin: 0 auto;
  }
  .about-features__title {
    color: {{ section.settings.section_title_color }};
    font-size: 2rem;
    margin-bottom: 3rem;
    text-align: center;
  }
  .about-features__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
  }
  .about-feature {
    background: white;
    padding: 2rem;
    border-radius: 8px;
    text-align: center;
  }
  .about-feature__icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .about-feature__title {
    color: {{ section.settings.section_title_color }};
    margin-bottom: 1rem;
    font-size: 1.25rem;
  }
  .about-feature__text {
    line-height: 1.6;
  }
  .about-stats {
    max-width: 1000px;
    margin: 4rem auto;
    padding: 0 2rem;
  }
  .about-stats__box {
    background: linear-gradient(135deg, {{ section.settings.stats_bg_start }} 0%, {{ section.settings.stats_bg_end }} 100%);
    padding: 3rem;
    border-radius: 12px;
    color: white;
    text-align: center;
  }
  .about-stats__title {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: white;
  }
  .about-stats__subtitle {
    font-size: 1.125rem;
    margin-bottom: 2rem;
    opacity: 0.95;
  }
  .about-stats__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }
  .about-stat__number {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }
  .about-cta {
    background: #F7F7F7;
    padding: 4rem 2rem;
    text-align: center;
  }
  .about-cta__container {
    max-width: 800px;
    margin: 0 auto;
  }
  .about-cta__title {
    color: {{ section.settings.section_title_color }};
    font-size: 2rem;
    margin-bottom: 1rem;
  }
  .about-cta__text {
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }
  .about-cta__info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .about-cta__button {
    display: inline-block;
    background: {{ section.settings.button_bg_color }};
    color: white;
    padding: 1rem 2.5rem;
    border-radius: 8px;
    font-weight: 600;
    text-decoration: none;
    font-size: 1.125rem;
  }
  .about-cta__button:hover {
    opacity: 0.9;
  }
  @media (max-width: 768px) {
    .about-hero__title {
      font-size: 2rem;
    }
    .about-section-title, .about-features__title, .about-stats__title, .about-cta__title {
      font-size: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="about-hero">
  <div class="about-hero__container">
    <h1 class="about-hero__title">{{ section.settings.hero_title }}</h1>
    <p class="about-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
  </div>
</div>

<div class="about-content">
  <div>
    <h2 class="about-section-title">{{ section.settings.story_title }}</h2>
    <div class="about-text">{{ section.settings.story_paragraph_1 }}</div>
    <div class="about-text">{{ section.settings.story_paragraph_2 }}</div>
    <div class="about-text">{{ section.settings.story_paragraph_3 }}</div>
  </div>
</div>

<div class="about-features">
  <div class="about-features__container">
    <h2 class="about-features__title">{{ section.settings.features_title }}</h2>
    <div class="about-features__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          <div class="about-feature" {{ block.shopify_attributes }}>
            <div class="about-feature__icon">{{ block.settings.icon }}</div>
            <h3 class="about-feature__title">{{ block.settings.title }}</h3>
            <p class="about-feature__text">{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<div class="about-stats">
  <div class="about-stats__box">
    <h2 class="about-stats__title">{{ section.settings.stats_title }}</h2>
    <p class="about-stats__subtitle">{{ section.settings.stats_subtitle }}</p>
    <div class="about-stats__grid">
      <div>
        <div class="about-stat__number">{{ section.settings.stat_1_number }}</div>
        <div>{{ section.settings.stat_1_label }}</div>
      </div>
      <div>
        <div class="about-stat__number">{{ section.settings.stat_2_number }}</div>
        <div>{{ section.settings.stat_2_label }}</div>
      </div>
      <div>
        <div class="about-stat__number">{{ section.settings.stat_3_number }}</div>
        <div>{{ section.settings.stat_3_label }}</div>
      </div>
    </div>
  </div>
</div>

<div class="about-cta">
  <div class="about-cta__container">
    <h2 class="about-cta__title">{{ section.settings.cta_title }}</h2>
    <p class="about-cta__text">{{ section.settings.cta_text }}</p>
    <div class="about-cta__info">
      <div>
        <strong style="color: {{ section.settings.section_title_color }};">{{ section.settings.info_1_label }}</strong><br>
        {{ section.settings.info_1_value }}
      </div>
      <div>
        <strong style="color: {{ section.settings.section_title_color }};">{{ section.settings.info_2_label }}</strong><br>
        {{ section.settings.info_2_value }}
      </div>
    </div>
    <a href="{{ section.settings.cta_button_url }}" class="about-cta__button">{{ section.settings.cta_button_text }}</a>
  </div>
</div>

