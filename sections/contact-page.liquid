{% comment %}
  Contact Page Section - Fully Editable
{% endcomment %}

{%- style -%}
  .contact-hero {
    background: linear-gradient(135deg, {{ section.settings.hero_bg_start }} 0%, {{ section.settings.hero_bg_end }} 100%);
    color: {{ section.settings.hero_text_color }};
    padding: 4rem 2rem;
    text-align: center;
  }
  .contact-hero__container {
    max-width: 800px;
    margin: 0 auto;
  }
  .contact-hero__title {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: {{ section.settings.hero_text_color }};
  }
  .contact-hero__subtitle {
    font-size: 1.25rem;
    opacity: 0.95;
  }
  .contact-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }
  .contact-alert {
    background: #F7F7F7;
    padding: 2rem;
    border-radius: 12px;
    margin-bottom: 3rem;
  }
  .contact-alert__text {
    text-align: center;
    color: #DC3545;
    font-weight: 600;
    font-size: 1.125rem;
    margin: 0;
  }
  .contact-info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .contact-card {
    text-align: center;
    padding: 2rem;
    background: #F7F7F7;
    border-radius: 8px;
  }
  .contact-card--highlight {
    background: linear-gradient(135deg, {{ section.settings.highlight_bg_start }} 0%, {{ section.settings.highlight_bg_end }} 100%);
    color: white;
  }
  .contact-card__icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }
  .contact-card__title {
    color: {{ section.settings.card_title_color }};
    margin-bottom: 0.5rem;
    font-size: 1.25rem;
  }
  .contact-card--highlight .contact-card__title {
    color: white;
  }
  .contact-card__content {
    line-height: 1.6;
  }
  .contact-card--highlight .contact-card__content {
    opacity: 0.95;
  }
  .contact-link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
  }
  .contact-link:hover {
    text-decoration: underline;
  }
  .contact-form {
    max-width: 600px;
    margin: 0 auto;
    padding: 0 2rem 4rem 2rem;
  }
  .contact-form__title {
    color: {{ section.settings.card_title_color }};
    font-size: 1.75rem;
    margin-bottom: 1rem;
    text-align: center;
  }
  .contact-form__intro {
    text-align: center;
    margin-bottom: 2rem;
  }
  .contact-form__field {
    margin-bottom: 1rem;
  }
  .contact-form__label {
    display: block;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }
  .contact-form__input {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid #E5E5E5;
    border-radius: 4px;
  }
  .contact-form__button {
    width: 100%;
    padding: 1rem;
    background: {{ section.settings.button_bg_color }};
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
  }
  .contact-form__button:hover {
    opacity: 0.9;
  }
  @media (max-width: 768px) {
    .contact-hero__title {
      font-size: 2rem;
    }
    .contact-form__title {
      font-size: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="contact-hero">
  <div class="contact-hero__container">
    <h1 class="contact-hero__title">{{ section.settings.hero_title }}</h1>
    <p class="contact-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
  </div>
</div>

<div class="contact-content">
  {%- if section.settings.show_alert -%}
    <div class="contact-alert">
      <p class="contact-alert__text">⚠️ {{ section.settings.alert_text }}</p>
    </div>
  {%- endif -%}

  <div class="contact-info">
    <div class="contact-card">
      <div class="contact-card__icon">📍</div>
      <h3 class="contact-card__title">{{ section.settings.address_title }}</h3>
      <div class="contact-card__content">{{ section.settings.address_line_1 }}<br>{{ section.settings.address_line_2 }}<br>{{ section.settings.address_line_3 }}</div>
    </div>

    <div class="contact-card">
      <div class="contact-card__icon">📧</div>
      <h3 class="contact-card__title">{{ section.settings.email_title }}</h3>
      <div class="contact-card__content">
        <a href="mailto:{{ section.settings.email_address }}" class="contact-link">{{ section.settings.email_address }}</a>
        {%- if section.settings.email_note != blank -%}
          <p style="font-size: 0.875rem; color: #666; margin-top: 0.5rem;">{{ section.settings.email_note }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="contact-card">
      <div class="contact-card__icon">📞</div>
      <h3 class="contact-card__title">{{ section.settings.phone_title }}</h3>
      <div class="contact-card__content">
        <strong>{{ section.settings.phone_1_label }}</strong><br>
        <a href="tel:{{ section.settings.phone_1_number | remove: ' ' }}" class="contact-link">{{ section.settings.phone_1_number }}</a><br><br>
        <strong>{{ section.settings.phone_2_label }}</strong><br>
        <a href="tel:{{ section.settings.phone_2_number | remove: ' ' }}" class="contact-link">{{ section.settings.phone_2_number }}</a>
      </div>
    </div>
  </div>

  <div class="contact-info">
    <div class="contact-card">
      <div class="contact-card__icon">🕒</div>
      <h3 class="contact-card__title">{{ section.settings.hours_title }}</h3>
      <div class="contact-card__content">
        <strong>{{ section.settings.hours_weekday_label }}</strong><br>
        {{ section.settings.hours_weekday_time }}<br><br>
        <strong>{{ section.settings.hours_closed_label }}</strong><br>
        {{ section.settings.hours_closed_days }}
        {%- if section.settings.hours_note != blank -%}
          <p style="font-size: 0.875rem; color: #666; margin-top: 1rem;">{{ section.settings.hours_note }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="contact-card contact-card--highlight">
      <div class="contact-card__icon">⏰</div>
      <h3 class="contact-card__title">{{ section.settings.support_title }}</h3>
      <div class="contact-card__content">{{ section.settings.support_text }}</div>
    </div>

    <div class="contact-card">
      <div class="contact-card__icon">🏢</div>
      <h3 class="contact-card__title">{{ section.settings.abn_title }}</h3>
      <div class="contact-card__content" style="font-size: 1.125rem; font-weight: 600;">{{ section.settings.abn_number }}</div>
    </div>
  </div>
</div>

{%- if section.settings.show_form -%}
  <div class="contact-form">
    <h2 class="contact-form__title">{{ section.settings.form_title }}</h2>
    <p class="contact-form__intro">{{ section.settings.form_intro }}</p>
    {% form 'contact' %}
      <div class="contact-form__field">
        <label for="ContactForm-name" class="contact-form__label">{{ section.settings.form_name_label }} *</label>
        <input type="text" id="ContactForm-name" name="contact[name]" required class="contact-form__input">
      </div>
      <div class="contact-form__field">
        <label for="ContactForm-email" class="contact-form__label">{{ section.settings.form_email_label }} *</label>
        <input type="email" id="ContactForm-email" name="contact[email]" required class="contact-form__input">
      </div>
      <div class="contact-form__field">
        <label for="ContactForm-phone" class="contact-form__label">{{ section.settings.form_phone_label }}</label>
        <input type="tel" id="ContactForm-phone" name="contact[phone]" class="contact-form__input">
      </div>
      <div class="contact-form__field">
        <label for="ContactForm-message" class="contact-form__label">{{ section.settings.form_message_label }} *</label>
        <textarea id="ContactForm-message" name="contact[body]" rows="6" required class="contact-form__input" style="resize: vertical;"></textarea>
      </div>
      <button type="submit" class="contact-form__button">{{ section.settings.form_button_text }}</button>
    {% endform %}
  </div>
{%- endif -%}

