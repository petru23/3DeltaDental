{% comment %}
  Trade Account Application Page - B2B trade account page for 3 Delta Dental
  Structure: Hero, benefits grid (blocks), how it works steps, application form embed area
  Fully editable from theme editor
{% endcomment %}

{%- liquid
  assign hero_bg_start = section.settings.hero_bg_start
  assign hero_bg_end = section.settings.hero_bg_end
  assign hero_text_color = section.settings.hero_text_color
  assign accent_color = section.settings.accent_color
  assign title_color = section.settings.title_color
-%}

{%- style -%}
  .trade-page {
    background-color: {{ section.settings.body_background_color }};
  }

  /* Hero */
  .trade-hero {
    background: linear-gradient(135deg, {{ hero_bg_start }} 0%, {{ hero_bg_end }} 100%);
    color: {{ hero_text_color }};
    padding: {{ section.settings.hero_padding_top }}px 2rem {{ section.settings.hero_padding_bottom }}px;
    position: relative;
    overflow: hidden;
  }

  .trade-hero::after {
    content: '';
    position: absolute;
    bottom: -40px;
    right: -40px;
    width: 300px;
    height: 300px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: 50%;
    pointer-events: none;
  }

  .trade-hero__container {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .trade-hero__content {
    max-width: 520px;
  }

  .trade-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px solid {{ accent_color }};
    color: {{ accent_color }};
    border-radius: 50px;
    padding: 0.3rem 1rem;
    margin-bottom: 1.25rem;
  }

  .trade-hero__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    margin: 0 0 1rem 0;
    letter-spacing: -0.02em;
    color: {{ hero_text_color }};
  }

  .trade-hero__subtitle {
    font-size: 1.05rem;
    line-height: 1.65;
    margin: 0 0 2rem 0;
    opacity: 0.9;
  }

  .trade-hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    background-color: {{ section.settings.hero_cta_bg }};
    color: {{ section.settings.hero_cta_text }};
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .trade-hero__cta:hover {
    opacity: 0.88;
    transform: translateY(-2px);
  }

  .trade-hero__card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 2rem;
    backdrop-filter: blur(4px);
  }

  .trade-hero__card-title {
    font-size: 1rem;
    font-weight: 700;
    color: {{ accent_color }};
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1.25rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .trade-hero__quick-benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .trade-hero__quick-benefits li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.92);
  }

  .trade-hero__quick-benefits li svg {
    color: {{ accent_color }};
    flex-shrink: 0;
  }

  /* Benefits Section */
  .trade-benefits {
    max-width: 1100px;
    margin: 0 auto;
    padding: {{ section.settings.benefits_padding_top }}px 2rem {{ section.settings.benefits_padding_bottom }}px;
  }

  .trade-benefits__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .trade-benefits__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ accent_color }};
    margin: 0 0 0.5rem 0;
  }

  .trade-benefits__title {
    font-size: 2rem;
    font-weight: 700;
    color: {{ title_color }};
    margin: 0 0 0.75rem 0;
    line-height: 1.2;
  }

  .trade-benefits__subtitle {
    font-size: 1rem;
    color: #6B7280;
    line-height: 1.6;
    max-width: 560px;
    margin: 0 auto;
  }

  .trade-benefits__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.benefits_columns }}, 1fr);
    gap: 1.5rem;
  }

  .benefit-card {
    background-color: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 10px;
    padding: 1.75rem 1.5rem;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    position: relative;
    overflow: hidden;
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: {{ accent_color }};
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .benefit-card:hover {
    box-shadow: 0 6px 20px rgba(0, 59, 86, 0.1);
    transform: translateY(-2px);
  }

  .benefit-card:hover::before {
    opacity: 1;
  }

  .benefit-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: {{ accent_color }}1A;
    border-radius: 10px;
    margin-bottom: 1.25rem;
    color: {{ accent_color }};
  }

  .benefit-card__title {
    font-size: 1.05rem;
    font-weight: 700;
    color: {{ title_color }};
    margin: 0 0 0.6rem 0;
  }

  .benefit-card__description {
    font-size: 0.9rem;
    line-height: 1.65;
    color: #6B7280;
    margin: 0;
  }

  /* How It Works Steps */
  .trade-steps {
    background-color: {{ section.settings.steps_bg_color }};
    padding: {{ section.settings.steps_padding_top }}px 2rem {{ section.settings.steps_padding_bottom }}px;
  }

  .trade-steps__container {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .trade-steps__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ accent_color }};
    margin: 0 0 0.5rem 0;
  }

  .trade-steps__title {
    font-size: 2rem;
    font-weight: 700;
    color: {{ title_color }};
    margin: 0 0 0.75rem 0;
  }

  .trade-steps__subtitle {
    font-size: 1rem;
    color: #6B7280;
    line-height: 1.6;
    margin: 0 0 3rem 0;
  }

  .trade-steps__list {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 0;
    position: relative;
  }

  .trade-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1rem;
    position: relative;
  }

  .trade-step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 24px;
    right: -50%;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, {{ accent_color }}, {{ title_color }}40);
    z-index: 0;
  }

  .trade-step__number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background-color: {{ accent_color }};
    color: #FFFFFF;
    border-radius: 50%;
    font-size: 1.1rem;
    font-weight: 800;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    box-shadow: 0 4px 12px {{ accent_color }}40;
  }

  .trade-step__title {
    font-size: 0.95rem;
    font-weight: 700;
    color: {{ title_color }};
    margin: 0 0 0.4rem 0;
  }

  .trade-step__description {
    font-size: 0.85rem;
    color: #6B7280;
    line-height: 1.5;
    margin: 0;
  }

  /* Application Form Area */
  .trade-form-section {
    max-width: 800px;
    margin: 0 auto;
    padding: {{ section.settings.form_padding_top }}px 2rem {{ section.settings.form_padding_bottom }}px;
  }

  .trade-form-section__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .trade-form-section__eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ accent_color }};
    margin: 0 0 0.5rem 0;
  }

  .trade-form-section__title {
    font-size: 2rem;
    font-weight: 700;
    color: {{ title_color }};
    margin: 0 0 0.75rem 0;
  }

  .trade-form-section__subtitle {
    font-size: 1rem;
    color: #6B7280;
    line-height: 1.6;
    margin: 0;
  }

  .trade-form-embed {
    background-color: {{ section.settings.card_background }};
    border: 1px solid {{ section.settings.card_border }};
    border-radius: 12px;
    padding: 2.5rem;
    margin-top: 2rem;
  }

  .trade-form-embed__note {
    background-color: #FEF3C7;
    border: 1px solid #FDE68A;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .trade-form-embed__note svg {
    color: #D97706;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .trade-form-embed__note-text {
    font-size: 0.875rem;
    color: #92400E;
    line-height: 1.5;
    margin: 0;
  }

  .trade-form-embed__note-text strong {
    display: block;
    margin-bottom: 0.2rem;
    color: #78350F;
  }

  .trade-form-placeholder {
    background-color: #F9FAFB;
    border: 2px dashed #D1D5DB;
    border-radius: 8px;
    padding: 3rem 2rem;
    text-align: center;
    color: #9CA3AF;
  }

  .trade-form-placeholder__icon {
    margin-bottom: 1rem;
    color: #D1D5DB;
  }

  .trade-form-placeholder p {
    margin: 0 0 0.5rem 0;
    font-size: 0.95rem;
  }

  .trade-form-placeholder p:first-of-type {
    font-weight: 600;
    color: #6B7280;
  }

  .trade-form-placeholder small {
    font-size: 0.8rem;
  }

  /* Custom form embed area - this is where the merchant pastes their form code */
  .trade-form-custom-content {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #374151;
  }

  .trade-form-custom-content h3 {
    color: {{ title_color }};
    font-size: 1.1rem;
    margin: 0 0 0.5rem 0;
  }

  /* Contact alternative */
  .trade-contact-alt {
    text-align: center;
    padding: 2rem;
    border-top: 1px solid {{ section.settings.card_border }};
    margin-top: 2rem;
  }

  .trade-contact-alt p {
    font-size: 0.9rem;
    color: #6B7280;
    margin: 0 0 0.75rem 0;
  }

  .trade-contact-alt__links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .trade-contact-alt__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: {{ title_color }};
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .trade-contact-alt__link:hover {
    color: {{ accent_color }};
  }

  /* Eligibility & terms */
  .trade-eligibility {
    background: linear-gradient(135deg, {{ hero_bg_start }} 0%, {{ hero_bg_end }} 100%);
    color: {{ hero_text_color }};
    padding: 3.5rem 2rem;
    text-align: center;
  }

  .trade-eligibility__container {
    max-width: 800px;
    margin: 0 auto;
  }

  .trade-eligibility__title {
    font-size: 1.75rem;
    font-weight: 700;
    color: {{ hero_text_color }};
    margin: 0 0 0.75rem 0;
  }

  .trade-eligibility__text {
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.9;
    margin: 0 0 1.75rem 0;
  }

  .trade-eligibility__items {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: 0.5rem;
  }

  .trade-eligibility__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    opacity: 0.9;
  }

  .trade-eligibility__item svg {
    color: {{ accent_color }};
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .trade-hero__container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .trade-hero__content {
      max-width: 100%;
    }

    .trade-benefits__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .trade-hero {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .trade-benefits {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .trade-steps {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .trade-form-section {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .trade-eligibility {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .trade-hero__title {
      font-size: 2rem;
    }

    .trade-benefits__title {
      font-size: 1.5rem;
    }

    .trade-benefits__grid {
      grid-template-columns: 1fr;
    }

    .trade-steps__list {
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .trade-step:not(:last-child)::after {
      display: none;
    }

    .trade-form-embed {
      padding: 1.5rem;
    }

    .trade-steps__title {
      font-size: 1.5rem;
    }

    .trade-form-section__title {
      font-size: 1.5rem;
    }

    .trade-eligibility__title {
      font-size: 1.5rem;
    }
  }
{%- endstyle -%}

<div class="trade-page">

  {%- comment %} Hero {%- endcomment %}
  <div class="trade-hero">
    <div class="trade-hero__container">
      <div class="trade-hero__content">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="trade-hero__eyebrow">{{ section.settings.hero_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.hero_title != blank -%}
          <h1 class="trade-hero__title">{{ section.settings.hero_title }}</h1>
        {%- endif -%}
        {%- if section.settings.hero_subtitle != blank -%}
          <p class="trade-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.hero_cta_label != blank and section.settings.hero_cta_link != blank -%}
          <a href="{{ section.settings.hero_cta_link }}" class="trade-hero__cta">
            {{ section.settings.hero_cta_label }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        {%- endif -%}
      </div>

      {%- comment %} Quick benefits card in hero {%- endcomment %}
      {%- if section.settings.show_hero_card -%}
        <div class="trade-hero__card">
          <p class="trade-hero__card-title">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            {{ section.settings.hero_card_title }}
          </p>
          <ul class="trade-hero__quick-benefits">
            {%- if section.settings.hero_benefit_1 != blank -%}
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                {{ section.settings.hero_benefit_1 }}
              </li>
            {%- endif -%}
            {%- if section.settings.hero_benefit_2 != blank -%}
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                {{ section.settings.hero_benefit_2 }}
              </li>
            {%- endif -%}
            {%- if section.settings.hero_benefit_3 != blank -%}
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                {{ section.settings.hero_benefit_3 }}
              </li>
            {%- endif -%}
            {%- if section.settings.hero_benefit_4 != blank -%}
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                {{ section.settings.hero_benefit_4 }}
              </li>
            {%- endif -%}
            {%- if section.settings.hero_benefit_5 != blank -%}
              <li>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                {{ section.settings.hero_benefit_5 }}
              </li>
            {%- endif -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment %} Benefits Grid (from blocks) {%- endcomment %}
  {%- assign benefit_blocks = section.blocks | where: "type", "benefit" -%}
  {%- if benefit_blocks.size > 0 -%}
    <div class="trade-benefits">
      <div class="trade-benefits__header">
        {%- if section.settings.benefits_eyebrow != blank -%}
          <p class="trade-benefits__eyebrow">{{ section.settings.benefits_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.benefits_title != blank -%}
          <h2 class="trade-benefits__title">{{ section.settings.benefits_title }}</h2>
        {%- endif -%}
        {%- if section.settings.benefits_subtitle != blank -%}
          <p class="trade-benefits__subtitle">{{ section.settings.benefits_subtitle }}</p>
        {%- endif -%}
      </div>

      <div class="trade-benefits__grid">
        {%- for block in benefit_blocks -%}
          <div class="benefit-card" {{ block.shopify_attributes }}>
            <div class="benefit-card__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'tag' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>
                  </svg>
                {%- when 'credit' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                  </svg>
                {%- when 'support' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                {%- when 'truck' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                  </svg>
                {%- when 'star' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                  </svg>
                {%- when 'users' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                {%- when 'box' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>
                  </svg>
                {%- else -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 6L9 17l-5-5"/>
                  </svg>
              {%- endcase -%}
            </div>
            <h3 class="benefit-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.description != blank -%}
              <p class="benefit-card__description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- comment %} How It Works Steps {%- endcomment %}
  {%- if section.settings.show_steps -%}
    <div class="trade-steps">
      <div class="trade-steps__container">
        {%- if section.settings.steps_eyebrow != blank -%}
          <p class="trade-steps__eyebrow">{{ section.settings.steps_eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.steps_title != blank -%}
          <h2 class="trade-steps__title">{{ section.settings.steps_title }}</h2>
        {%- endif -%}
        {%- if section.settings.steps_subtitle != blank -%}
          <p class="trade-steps__subtitle">{{ section.settings.steps_subtitle }}</p>
        {%- endif -%}

        <div class="trade-steps__list">
          {%- for i in (1..4) -%}
            {%- assign step_title_key = "step_" | append: i | append: "_title" -%}
            {%- assign step_desc_key = "step_" | append: i | append: "_description" -%}
            {%- if section.settings[step_title_key] != blank -%}
              <div class="trade-step">
                <div class="trade-step__number" aria-hidden="true">{{ i }}</div>
                <p class="trade-step__title">{{ section.settings[step_title_key] }}</p>
                {%- if section.settings[step_desc_key] != blank -%}
                  <p class="trade-step__description">{{ section.settings[step_desc_key] }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment %} Application Form Area {%- endcomment %}
  <div class="trade-form-section">
    <div class="trade-form-section__header">
      {%- if section.settings.form_eyebrow != blank -%}
        <p class="trade-form-section__eyebrow">{{ section.settings.form_eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.form_title != blank -%}
        <h2 class="trade-form-section__title">{{ section.settings.form_title }}</h2>
      {%- endif -%}
      {%- if section.settings.form_subtitle != blank -%}
        <p class="trade-form-section__subtitle">{{ section.settings.form_subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="trade-form-embed">
      {%- comment %} Admin notice about form embedding {%- endcomment %}
      {%- if section.settings.show_form_note -%}
        <div class="trade-form-embed__note" role="note">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <p class="trade-form-embed__note-text">
            <strong>{{ section.settings.form_note_title }}</strong>
            {{ section.settings.form_note_text }}
          </p>
        </div>
      {%- endif -%}

      {%- comment %} Custom form content - merchant adds form embed code here via theme editor {%- endcomment %}
      {%- if section.settings.form_custom_content != blank -%}
        <div class="trade-form-custom-content">
          {{ section.settings.form_custom_content }}
        </div>
      {%- else -%}
        <div class="trade-form-placeholder">
          <div class="trade-form-placeholder__icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
            </svg>
          </div>
          <p>Trade Account Application Form</p>
          <p><small>To embed your form, paste the form embed code into the "Form Custom Content" field in the theme editor, or use a Shopify form app.</small></p>
        </div>
      {%- endif -%}

      <div class="trade-contact-alt">
        <p>{{ section.settings.contact_alt_text }}</p>
        <div class="trade-contact-alt__links">
          {%- if section.settings.contact_phone != blank -%}
            <a href="tel:{{ section.settings.contact_phone | remove: ' ' }}" class="trade-contact-alt__link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              {{ section.settings.contact_phone }}
            </a>
          {%- endif -%}
          {%- if section.settings.contact_email != blank -%}
            <a href="mailto:{{ section.settings.contact_email }}" class="trade-contact-alt__link">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
              {{ section.settings.contact_email }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment %} Eligibility Section {%- endcomment %}
  {%- if section.settings.eligibility_title != blank -%}
    <div class="trade-eligibility">
      <div class="trade-eligibility__container">
        <h2 class="trade-eligibility__title">{{ section.settings.eligibility_title }}</h2>
        {%- if section.settings.eligibility_text != blank -%}
          <p class="trade-eligibility__text">{{ section.settings.eligibility_text }}</p>
        {%- endif -%}
        <div class="trade-eligibility__items">
          {%- if section.settings.eligibility_1 != blank -%}
            <span class="trade-eligibility__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              {{ section.settings.eligibility_1 }}
            </span>
          {%- endif -%}
          {%- if section.settings.eligibility_2 != blank -%}
            <span class="trade-eligibility__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              {{ section.settings.eligibility_2 }}
            </span>
          {%- endif -%}
          {%- if section.settings.eligibility_3 != blank -%}
            <span class="trade-eligibility__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              {{ section.settings.eligibility_3 }}
            </span>
          {%- endif -%}
          {%- if section.settings.eligibility_4 != blank -%}
            <span class="trade-eligibility__item">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
              {{ section.settings.eligibility_4 }}
            </span>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

</div>

