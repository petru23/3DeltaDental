{
  "sections": {
    "main": {
      "type": "main-page",
      "disabled": true
    },
    "new_products_hero": {
      "type": "new-products-page",
      "blocks": {
        "card_acrylics": {
          "type": "highlight_card",
          "settings": {
            "icon": "🦷",
            "badge": "New",
            "title": "New Acrylics Range",
            "description": "Expanded shade options and faster processing acrylics from our European partners.",
            "link_label": "Shop Acrylics",
            "link": "/collections/acrylics"
          }
        },
        "card_cad_cam": {
          "type": "highlight_card",
          "settings": {
            "icon": "💎",
            "badge": "Just In",
            "title": "Zirconia & CAD/CAM",
            "description": "High-translucency and multi-layer zirconia blanks for modern CAD/CAM workflows.",
            "link_label": "Shop CAD/CAM",
            "link": "/collections/cad-cam"
          }
        },
        "card_equipment": {
          "type": "highlight_card",
          "settings": {
            "icon": "🔧",
            "badge": "Expanded",
            "title": "Lab Equipment",
            "description": "New machinery and tools to optimise your dental laboratory workflow.",
            "link_label": "Shop Equipment",
            "link": "/collections/equipment"
          }
        }
      },
      "block_order": [
        "card_acrylics",
        "card_cad_cam",
        "card_equipment"
      ],
      "settings": {
        "hero_badge": "Just Arrived",
        "hero_title": "New Products",
        "hero_subtitle": "Discover the latest additions to our dental lab supply range — new brands, new materials, and new innovations from Europe.",
        "hero_cta_label": "Browse New Arrivals",
        "hero_cta_link": "/collections/new-arrivals",
        "hero_padding_top": 80,
        "hero_padding_bottom": 80,
        "highlights_heading": "What's New This Season",
        "highlights_subheading": "Fresh stock, new suppliers, and expanded ranges — curated for Australian dental laboratories.",
        "highlight_columns": 3,
        "highlights_padding_top": 70,
        "highlights_padding_bottom": 70,
        "show_cta_strip": true,
        "cta_strip_title": "Want First Access to New Products?",
        "cta_strip_text": "Apply for a trade account to receive new product notifications, priority access, and exclusive pricing.",
        "cta_strip_btn_label": "Apply for Trade Account",
        "cta_strip_btn_link": "/pages/trade-account",
        "hero_bg_start": "#003B56",
        "hero_bg_end": "#005A7A",
        "hero_text_color": "#FFFFFF",
        "accent_color": "#03B239",
        "cta_text_color": "#FFFFFF",
        "highlights_bg": "#F5F7FA",
        "card_bg": "#FFFFFF",
        "card_border": "#E5E7EB",
        "title_color": "#003B56",
        "body_color": "#555555"
      }
    },
    "new_products_list": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "New Arrivals Header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "inherit_color_scheme": true,
            "color_scheme": "",
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "header_text": {
              "type": "_product-list-text",
              "name": "Header Text",
              "settings": {
                "text": "<h3>Latest Arrivals</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground-heading)",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "header_btn": {
              "type": "_product-list-button",
              "name": "View All Button",
              "settings": {
                "label": "View all new products",
                "open_in_new_tab": false,
                "style_class": "link",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              },
              "blocks": {}
            }
          },
          "block_order": [
            "header_text",
            "header_btn"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "inherit_color_scheme": true,
            "color_scheme": "",
            "border": "all",
            "border_width": 1,
            "border_opacity": 15,
            "border_radius": 8,
            "padding-block-start": 12,
            "padding-block-end": 12,
            "padding-inline-start": 12,
            "padding-inline-end": 12
          },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 4,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "0.938rem",
                "line_height": "1.4",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground-heading)",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 4,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "sku_display": {
              "type": "custom-liquid",
              "name": "SKU Display",
              "settings": {
                "custom_liquid": "<p style=\"font-size: 0.813rem; color: #666; margin: 4px 0 8px 0;\">SKU: {{ product.variants.first.sku }}</p>"
              },
              "blocks": {}
            },
            "product_price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": true,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "color": "var(--color-primary)",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "product_card_gallery",
            "product_title",
            "sku_display",
            "product_price"
          ]
        }
      },
      "name": "New Arrivals Products",
      "settings": {
        "collection": "new-arrivals",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 12,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "75cqw",
        "columns_gap": 16,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 32,
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 64
      }
    }
  },
  "order": [
    "main",
    "new_products_hero",
    "new_products_list"
  ]
}
