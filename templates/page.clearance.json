{
  "sections": {
    "main": {
      "type": "main-page",
      "disabled": true
    },
    "clearance_hero": {
      "type": "clearance-page",
      "blocks": {
        "tier_acrylics": {
          "type": "tier_card",
          "settings": {
            "icon": "🦷",
            "discount_amount": "40%",
            "title": "Acrylics",
            "description": "End-of-line acrylic materials and shade systems at clearance pricing.",
            "link_label": "Shop Acrylics",
            "link": "/collections/acrylics",
            "featured": true
          }
        },
        "tier_burs": {
          "type": "tier_card",
          "settings": {
            "icon": "⚙️",
            "discount_amount": "30%",
            "title": "Burs & Discs",
            "description": "Selected burs and cutting discs at heavily reduced prices.",
            "link_label": "Shop Burs",
            "link": "/collections/burs",
            "featured": false
          }
        },
        "tier_polishing": {
          "type": "tier_card",
          "settings": {
            "icon": "✨",
            "discount_amount": "25%",
            "title": "Polishing Materials",
            "description": "Polishing compounds and finishing materials on clearance.",
            "link_label": "Shop Polishing",
            "link": "/collections/polishing",
            "featured": false
          }
        }
      },
      "block_order": [
        "tier_acrylics",
        "tier_burs",
        "tier_polishing"
      ],
      "settings": {
        "hero_badge": "Clearance Sale",
        "hero_title": "Clearance — Up to 40% Off",
        "hero_subtitle": "Limited stock on selected dental lab supplies. All TGA-approved products. While stocks last.",
        "hero_cta_label": "Shop Clearance Now",
        "hero_cta_link": "/collections/clearance",
        "discount_value": "40%",
        "hero_padding_top": 80,
        "hero_padding_bottom": 80,
        "show_urgency_bar": true,
        "urgency_text": "Limited stock — once it's gone, it's gone. Order today to avoid disappointment.",
        "tiers_heading": "Clearance Categories",
        "tiers_subheading": "Shop by category and save big on end-of-line and overstocked dental lab supplies.",
        "tier_columns": 3,
        "tiers_padding_top": 70,
        "tiers_padding_bottom": 70,
        "background_color": "#FFFFFF",
        "blue_color": "#003B56",
        "accent_color": "#03B239",
        "gold_color": "#FED440",
        "hero_text_color": "#FFFFFF",
        "cta_text_color": "#FFFFFF",
        "tiers_bg": "#F5F7FA",
        "tier_card_bg": "#FFFFFF",
        "tier_card_border": "#E5E7EB",
        "body_color": "#555555"
      }
    },
    "clearance_products": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "Clearance Products Header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "inherit_color_scheme": true,
            "color_scheme": "",
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "header_text": {
              "type": "_product-list-text",
              "name": "Header Text",
              "settings": {
                "text": "<h3>Clearance Products</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h3",
                "font": "var(--font-body--family)",
                "font_size": "",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground-heading)",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "header_btn": {
              "type": "_product-list-button",
              "name": "View All Button",
              "settings": {
                "label": "View all clearance",
                "open_in_new_tab": false,
                "style_class": "link",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              },
              "blocks": {}
            }
          },
          "block_order": [
            "header_text",
            "header_btn"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 8,
            "inherit_color_scheme": true,
            "color_scheme": "",
            "border": "all",
            "border_width": 1,
            "border_opacity": 15,
            "border_radius": 8,
            "padding-block-start": 12,
            "padding-block-end": 12,
            "padding-inline-start": 12,
            "padding-inline-end": 12
          },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 4,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "0.938rem",
                "line_height": "1.4",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "color": "var(--color-foreground-heading)",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 8,
                "padding-block-end": 4,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            },
            "sku_display": {
              "type": "custom-liquid",
              "name": "SKU Display",
              "settings": {
                "custom_liquid": "<p style=\"font-size: 0.813rem; color: #666; margin: 4px 0 8px 0;\">SKU: {{ product.variants.first.sku }}</p>"
              },
              "blocks": {}
            },
            "product_price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": true,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "color": "var(--color-primary)",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              },
              "blocks": {}
            }
          },
          "block_order": [
            "product_card_gallery",
            "product_title",
            "sku_display",
            "product_price"
          ]
        }
      },
      "name": "Clearance Products",
      "settings": {
        "collection": "clearance",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 12,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "75cqw",
        "columns_gap": 16,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "circle",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 32,
        "color_scheme": "scheme-1",
        "padding-block-start": 48,
        "padding-block-end": 64
      }
    }
  },
  "order": [
    "main",
    "clearance_hero",
    "clearance_products"
  ]
}
